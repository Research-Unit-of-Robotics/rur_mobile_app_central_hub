<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#051221"
    tools:context=".CameraPage">

    <!-- BARRA SUPERIOR AMARILLA -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#FFCC00"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Estado de Conexión (Píldora) -->
        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="16dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Usamos un borde dibujado con stroke si es posible, pero para simplificar ponemos un fondo sólido amarillo con borde simulado -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="📶 Disconnected"
                android:textColor="#B30000"
                android:textSize="12sp"
                android:textStyle="bold" />
        </androidx.cardview.widget.CardView>

        <!-- Título Central -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rover- Name"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Botón de Ajustes (Tuerca) -->
        <ImageButton
            android:id="@+id/btn_open_settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@android:drawable/ic_menu_preferences"
            app:tint="#000000" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ZONA CENTRAL DE LA CÁMARA (Fondo oscuro por defecto) -->
    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBar"
        app:srcCompat="@android:drawable/ic_menu_camera"
        app:tint="#1A2A40" />

    <!-- JOYSTICK (Izquierda) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/joystick_base"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginStart="32dp"
        app:cardBackgroundColor="#0A1526"
        app:cardCornerRadius="32dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBar">

        <!-- Botón central del joystick -->
        <androidx.cardview.widget.CardView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            app:cardBackgroundColor="#7A828A"
            app:cardCornerRadius="30dp"
            app:cardElevation="4dp" />
    </androidx.cardview.widget.CardView>

    <!-- BOTONES DE ACCIÓN RÁPIDA (Derecha) -->
    <LinearLayout
        android:id="@+id/action_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="40dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBar">

        <ImageButton
            android:id="@+id/btn_take_photo"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#FFCC00"
            app:srcCompat="@android:drawable/ic_menu_camera" />

        <ImageButton
            android:id="@+id/btn_record_video"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:backgroundTint="#FFCC00"
            app:srcCompat="@android:drawable/ic_menu_slideshow" />
    </LinearLayout>

    <!-- PESTAÑA LATERAL (Abre el panel de métricas) -->
    <LinearLayout
        android:id="@+id/tab_open_metrics"
        android:layout_width="24dp"
        android:layout_height="0dp"
        android:background="#FFCC00"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBar">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:rotation="-90"
            android:text="Metrics"
            android:textColor="#000000"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>


    <!-- ========================================== -->
    <!-- PANEL 1: MÉTRICAS (Oculto por defecto con visibility="gone") -->
    <!-- ========================================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/panel_metrics"
        android:layout_width="300dp"
        android:layout_height="0dp"
        android:background="#F8F9FA"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBar">

        <TextView
            android:id="@+id/tv_telemetry_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:text="Telemetry"
            android:textColor="#FFCC00"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Grid de métricas -->
        <androidx.gridlayout.widget.GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingHorizontal="16dp"
            app:columnCount="2"
            app:layout_constraintTop_toBottomOf="@+id/tv_telemetry_title">

            <!-- Métrica 1: Batería -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_margin="6dp"
                app:cardBackgroundColor="#0A1526"
                app:cardCornerRadius="12dp"
                app:layout_columnWeight="1">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="8dp">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" app:srcCompat="@android:drawable/ic_lock_idle_charging" app:tint="#4CAF50"/>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Battery" android:textColor="#FFCC00" android:textSize="10sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="87%" android:textColor="@android:color/white" android:textSize="12sp" android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Métrica 2: Velocidad -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_margin="6dp"
                app:cardBackgroundColor="#0A1526"
                app:cardCornerRadius="12dp"
                app:layout_columnWeight="1">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="8dp">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" app:srcCompat="@android:drawable/ic_menu_compass" app:tint="#2196F3"/>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Speed" android:textColor="#FFCC00" android:textSize="10sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2.3 m/s" android:textColor="@android:color/white" android:textSize="12sp" android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Puedes añadir el resto de los cuadros de métricas (Heading, Temp, Altitude, Signal) siguiendo la misma estructura -->

        </androidx.gridlayout.widget.GridLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- ========================================== -->
    <!-- PANEL 2: AJUSTES (Oculto por defecto con visibility="gone") -->
    <!-- ========================================== -->
    <androidx.cardview.widget.CardView
        android:id="@+id/panel_settings"
        android:layout_width="320dp"
        android:layout_height="0dp"
        app:cardBackgroundColor="#7A828A"
        app:cardCornerRadius="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Settings"
                    android:textColor="#FFCC00"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/btn_close_settings"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_alignParentEnd="true"
                    app:srcCompat="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="#FFCC00" />
            </RelativeLayout>

            <!-- Opción 1: Auto Reconnect -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="16dp">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="16dp">

                    <ImageView android:id="@+id/ic_conn" android:layout_width="24dp" android:layout_height="24dp" android:layout_centerVertical="true" app:srcCompat="@android:drawable/ic_menu_share" />

                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_toEndOf="@id/ic_conn" android:layout_marginStart="12dp" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Auto Reconnect" android:textColor="#FFCC00" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Reconnect on signal loss" android:textColor="#555555" android:textSize="10sp"/>
                    </LinearLayout>

                    <Switch android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:checked="true"/>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>